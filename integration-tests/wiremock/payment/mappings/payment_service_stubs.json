{
  "mappings": [
    {
      "id": "payment-initiate",
      "name": "PaymentManagementService - Initiate payment",
      "request": {
        "method": "POST",
        "url": "/api/payments/initiate"
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "success": true,
          "externalReference": "ext-ref-mock-001",
          "providerReference": "camp-ref-mock-001",
          "provider": "CAMPAY",
          "status": "PENDING",
          "amount": 1000,
          "message": "Payment request sent. Please confirm on your phone."
        }
      }
    },
    {
      "id": "payment-webhook-forward-campay",
      "name": "PaymentManagementService - Webhook CamPay",
      "request": {
        "method": "POST",
        "url": "/api/webhook/campay"
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "status": "received" }
      }
    },
    {
      "id": "payment-webhook-forward-mtn",
      "name": "PaymentManagementService - Webhook MTN",
      "request": {
        "method": "POST",
        "url": "/api/webhook/mtn"
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "status": "received" }
      }
    },
    {
      "id": "payment-transaction-get",
      "name": "PaymentManagementService - Get transaction",
      "request": {
        "method": "GET",
        "urlPathPattern": "/api/payments/transaction/.*"
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "externalReference": "ext-ref-mock-001",
          "status": "PENDING",
          "amount": 1000,
          "currency": "XAF",
          "machineId": "washer_01",
          "provider": "CAMPAY"
        }
      }
    }
  ]
}
